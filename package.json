{
  "name": "aistos-dev-env",
  "version": "1.0.0",
  "private": true,
  "description": "Local build and audit tools for the Aistos Privacy Sandbox",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "audit:permissions": "node scripts/audit_permissions.js",
    "audit:bloat": "node scripts/audit_memory_bloat.js",
    "audit:leaks": "node scripts/audit_memory_leaks.js",
    "audit:all": "npm run audit:permissions && npm run audit:bloat && npm run audit:leaks",
    "lint": "eslint .",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "addons-linter": "^6.20.0",
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.3.0"
  }
}